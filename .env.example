# Copy this file to .env and fill in what you use. Everything is optional.

# Web server. Keep HOST at 127.0.0.1 so only your own PC can reach it.
HOST=127.0.0.1
PORT=3000

# Twitch: the channel to read chat from (no login needed, read-only).
TWITCH_CHANNEL=

# YouTube: an API key from Google Cloud (YouTube Data API v3) plus the
# video ID of your live stream (the part after watch?v=).
YOUTUBE_API_KEY=
YOUTUBE_VIDEO_ID=
# How often to poll YouTube chat, in ms. Lower uses more API quota.
YOUTUBE_POLL_MS=8000

# The test console at /console lets you type chat as any user.
# Set to false while live if you don't want it.
TEST_CONSOLE=true

# Where player data is saved.
DATA_FILE=data/world.json
